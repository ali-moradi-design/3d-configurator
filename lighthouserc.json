{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "index\\.html$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ]
          }
        }
      ]
    }
  }
}
