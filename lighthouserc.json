{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader"
      },
      "startServerCommand": "node scripts/serve.mjs 3000",
      "startServerReadyPattern": "standalone server",
      "url": ["http://127.0.0.1:3000/"]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.8
              }
            ]
          }
        }
      ]
    }
  }
}
